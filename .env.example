# =============================================================================
# Google Cloud Platform & ADK Agent Engine Configuration
# =============================================================================
GOOGLE_CLOUD_PROJECT="<your_gcp_project_id>"
PROJECT_ID="<your_gcp_project_id>"
GOOGLE_CLOUD_REGION="us-central1"
GOOGLE_CLOUD_LOCATION="global"
STAGING_BUCKET="gs://<your_staging_bucket_name>"

# =============================================================================
# Gemini Enterprise Assistant & Intranet App Configuration
# =============================================================================
GEMINI_ENTERPRISE_URL="https://vertexaisearch.cloud.google.com/home/cid/<your_collection_id>"
GEMINI_ENTERPRISE_APP_ID="projects/<project_number>/locations/global/collections/default_collection/engines/<engine_id>"

# =============================================================================
# Chrome Browser & Profile Settings for Demo Video Recorder
# =============================================================================
CHROME_PROFILE_NAME="<Your Chrome Profile Name, e.g. First Last (user@example.com)>"
CHROME_PROFILE_DIR="<Profile Directory, e.g. Profile 2 or Default>"
CHROME_USER_DATA_DIR="~/.config/google-chrome"
